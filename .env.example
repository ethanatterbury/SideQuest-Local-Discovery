# Regional OpenStreetMap / Overpass discovery works without keys.
# Optional live national listings, server only: https://myprojects.geoapify.com/
# Use a Free project; no payment card needed. Never use NEXT_PUBLIC_ for this key.
GEOAPIFY_API_KEY=
# Optional production vector style:
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
# Enable the Environment Lab on a private preview. Never use for public production.
NEXT_PUBLIC_ENABLE_ENVIRONMENT_LAB=false
# Absolute production origin for metadata (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
